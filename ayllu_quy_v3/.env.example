# Ayllu · variables de entorno (ninguna es obligatoria: sin ellas la app
# arranca en modo degradado con la semilla en memoria).

# --- Persistencia -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Compatibility for older projects; use only on the server and rotate legacy keys.
# SUPABASE_KEY=

# --- Traducción y adaptación ------------------------------------------------
# El endpoint público de Google se prueba primero; si no responde, se usa NLLB
# y luego el glosario local (glosa, no traducción completa).
GOOGLE_TIMEOUT=8
GOOGLE_MAX_RETRIES=2
NLLB_API_URL=
NLLB_TIMEOUT=20
HF_API_URL=
HF_API_TOKEN=
# Hugging Face Inference Providers URL for NLLB (optional fallback):
# https://router.huggingface.co/hf-inference/models/facebook/nllb-200-distilled-600M
# The free monthly credits are limited. NLLB supports quy_Latn (Ayacucho), not
# qub_Latn (Ancashino); always review low-resource translations with a speaker.
LLM_API_URL=
LLM_API_KEY=
LLM_TIMEOUT=20

# --- Escáner de documentos --------------------------------------------------
AYLLU_MAX_UPLOAD_MB=8

# --- Sesión y cuentas de demostración ---------------------------------------
# Déjalo vacío en demo. Para AYLLU_REQUIRE_AUTH=1 configura un secreto aleatorio
# de al menos 32 caracteres; la app rechaza el secreto de ejemplo.
AYLLU_SECRET=
# Claves de cada rol (sobrescriben las de core/seed.py)
AYLLU_DOCENTE_PASSWORD=ayllu-docente
AYLLU_ESTUDIANTE_PASSWORD=ayllu-estudiante
# AYLLU_DEMO_LOGIN=0 publica el directorio de cuentas sólo cuando interesa
AYLLU_DEMO_LOGIN=1
# AYLLU_REQUIRE_AUTH=1 exige token Bearer en las escrituras
AYLLU_REQUIRE_AUTH=0

# --- Runtime ----------------------------------------------------------------
PORT=5000
FLASK_DEBUG=0
